{
    "name": "saksham-frontend",
    "version": "0.1.0",
    "description": "Saksham AI - Your Personal Jarvis",
    "main": "dist-electron/main.js",
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "dev": "vite",
        "test": "vitest run",
        "build": "tsc && vite build",
        "preview": "vite preview",
        "electron:dev": "concurrently \"vite\" \"tsc -p tsconfig.electron.json --watch\" \"wait-on http://localhost:5173 dist-electron/main.js && electron .\"",
        "electron:build": "tsc -p tsconfig.electron.json && vite build && electron-builder"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.116.0",
        "framer-motion": "^11.0.0",
        "lucide-react": "^0.312.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0"
    },
    "devDependencies": {
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.2",
        "@types/react": "^18.2.48",
        "@types/react-dom": "^18.2.18",
        "@vitejs/plugin-react": "^4.2.1",
        "concurrently": "^8.2.2",
        "electron": "^28.2.0",
        "electron-builder": "^24.9.1",
        "jsdom": "^29.1.1",
        "typescript": "^5.3.3",
        "vite": "^5.0.12",
        "vitest": "^4.1.10",
        "wait-on": "^7.2.0"
    },
    "build": {
        "appId": "ai.saksham.app",
        "productName": "Saksham AI",
        "directories": {
            "output": "dist"
        },
        "mac": {
            "category": "public.app-category.productivity",
            "icon": "assets/icon.icns"
        }
    }
}
