# Public hostname is configured in Cloudflare: api.saksham.ai -> gateway:8080.
# Never commit this file after inserting real values.
SUPABASE_URL=https://your-project.supabase.co
# Use a random URL-safe value; Compose constructs DATABASE_URL from it.
POSTGRES_PASSWORD=replace-with-a-long-random-password
CLOUDFLARE_TUNNEL_TOKEN=replace-with-a-cloudflare-tunnel-token

# Home model endpoint. host.docker.internal reaches an LM Studio server on this host.
HOSTED_LLM_BASE_URL=http://host.docker.internal:1234/v1
HOSTED_LLM_API_KEY=replace-with-your-local-model-key
HOSTED_LLM_MODEL=openai/gpt-oss-20b

# Meeting worker must remain on the Docker private network or host loopback.
MEETING_WORKER_URL=http://host.docker.internal:8110
MEETING_WORKER_API_KEY=replace-with-a-long-random-worker-key

CORS_ORIGINS=["https://saksham.ai","https://www.saksham.ai"]
ALLOWED_BYOK_HOSTS=["api.openai.com"]
DAILY_TOKEN_LIMIT=10000
DAILY_GLOBAL_TOKEN_LIMIT=50000
MAX_OUTPUT_TOKENS=1024
DAILY_MEETING_MINUTES=30
DAILY_GLOBAL_MEETING_MINUTES=120
MAX_HOSTED_MEETING_UPLOAD_SECONDS=900
MAX_CONCURRENT_HOSTED_JOBS=1

# Enable only after testing the dedicated worker/model endpoints locally.
HOSTED_ENABLED=false
# Users may register, but the gateway admits only these Supabase user UUIDs.
BETA_INVITE_ONLY=true
BETA_USER_IDS=[]
