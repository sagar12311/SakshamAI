# Saksham AI Configuration
# Copy this file to .env and fill in your values

# Configure one OpenAI-compatible local or hosted provider. Never commit a real key.
LLM_API_KEY=lm-studio
LLM_BASE_URL=http://127.0.0.1:1234/v1
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=1024

# Application Settings
DEBUG=false
LOG_LEVEL=INFO

# Server Settings
HOST=127.0.0.1
PORT=8420
# JSON array of trusted browser origins. Keep this limited to the local
# Saksham frontend; do not use "*".
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Voice Settings
VOICE_ENABLED=true
WHISPER_MODEL=base
VOICE_TURN_SETTLE_SECONDS=0.85
VOICE_INCOMPLETE_TURN_SETTLE_SECONDS=2.0
TTS_ENABLED=true
TTS_PROVIDER=edge
TTS_VOICE=alloy
EDGE_TTS_VOICE=en-US-AndrewMultilingualNeural
# Chatterbox Turbo service. Keep it loopback-only unless you operate a private network.
CHATTERBOX_TTS_URL=http://127.0.0.1:8100
CHATTERBOX_TTS_API_KEY=replace-with-the-same-random-token-used-by-the-service
CHATTERBOX_TTS_VOICE=saksham
CHATTERBOX_TTS_TIMEOUT_SECONDS=45
CHATTERBOX_TTS_FALLBACK=none
CHATTERBOX_TTS_AUTOSTART=false
CHATTERBOX_TTS_STARTUP_TIMEOUT_SECONDS=120

# Meeting intelligence (local worker is optional; backend ASR remains a fallback)
MEETING_MODE_ENABLED=true
PROJECTS_ROOT=~/Documents/Saksham Projects
MEETING_AUDIO_RETENTION_DAYS=30
MEETING_LIVE_TRANSCRIPTION_SECONDS=3
MEETING_POINTER_INTERVAL_SECONDS=45
MEETING_LIVE_WHISPER_MODEL=small
MEETING_FINAL_WHISPER_MODEL=large-v3-turbo
MEETING_LOCAL_FINAL_WHISPER_MODEL=small
MEETING_INTELLIGENCE_LOCAL_URL=http://127.0.0.1:8110
# MEETING_INTELLIGENCE_REMOTE_URL=http://your-private-rtx-server:8110
# MEETING_INTELLIGENCE_API_KEY=replace-with-a-random-shared-token
MEETING_INTELLIGENCE_AUTOSTART=false
MEETING_INTELLIGENCE_STARTUP_TIMEOUT_SECONDS=180

# Dangerous-task-only hands-free admin activation. Keep the worker private.
# Enrollment is performed over trusted SSH: python -m admin_setup enroll --sample ...
ADMIN_VOICE_ENABLED=false
# ADMIN_VOICE_WORKER_URL=http://127.0.0.1:8110
HEADLESS_MODE=false
HANDS_FREE_MODE=false

# Optional deterministic personal Amazon.in COD rehearsal. The first verified
# admin ceremony is a no-click rehearsal; the single live order remains capped
# in code at ₹500 total.
AMAZON_COMMERCE_ENABLED=false
AMAZON_COMMERCE_BROWSER=Google Chrome
AMAZON_COMMERCE_MAX_TOTAL_INR=500
AMAZON_COMMERCE_SESSION_TTL_SECONDS=900
# Require a local, ephemeral screenshot/OCR check before opening a product.
# macOS Screen Recording permission must be granted to the Saksham process.
AMAZON_COMMERCE_REQUIRE_SCREEN_OBSERVATION=false

# Operating Mode (assist, execute, autonomous, shadow)
DEFAULT_MODE=assist

# Security
REQUIRE_CONFIRMATION_FOR_DESTRUCTIVE=true

# Mac Integration
MAC_AUTOMATION_ENABLED=false

# Apple Music catalog matching (optional)
# Create this token after enabling MusicKit for Saksham's App ID in Apple Developer.
# Catalog playback additionally requires the user to authorize Apple Music in MusicKit.
APPLE_MUSIC_DEVELOPER_TOKEN=
APPLE_MUSIC_STOREFRONT=in
APPLE_MUSIC_CATALOG_TIMEOUT_SECONDS=10

# Bounded music fallback. An API key improves result selection, but Chrome search
# automation remains available without one.
YOUTUBE_MUSIC_FALLBACK_ENABLED=true
YOUTUBE_API_KEY=
YOUTUBE_SEARCH_TIMEOUT_SECONDS=10
YOUTUBE_BROWSER=Google Chrome
