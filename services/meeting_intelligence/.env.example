MEETING_INTELLIGENCE_API_KEY=replace-with-a-random-shared-token
HF_TOKEN=replace-after-accepting-the-pyannote-model-conditions
MEETING_INTELLIGENCE_DEVICE=auto
MEETING_ASR_MODEL=large-v3-turbo
MEETING_DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
MEETING_EMBEDDING_MODEL=pyannote/wespeaker-voxceleb-resnet34-LM
MEETING_GPU_MIN_FREE_MB=4500
ADMIN_VOICE_AUTH_ENABLED=false
ADMIN_ANTISPOOF_ARCHITECTURE=/opt/aasist/models/AASIST.py
ADMIN_ANTISPOOF_MODEL=/opt/aasist/models/weights/AASIST.pth
ADMIN_SPEAKER_THRESHOLD=0.82
ADMIN_LIVENESS_THRESHOLD=0.90
PYANNOTE_METRICS_ENABLED=0
# Set both to 1 after the models have been downloaded or local model paths are configured.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0
