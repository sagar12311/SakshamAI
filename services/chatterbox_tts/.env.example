# Generate with: openssl rand -hex 32
TTS_API_KEY=replace-with-a-long-random-token

# Use 127.0.0.1 when Saksham runs on this host. For a Mac over Tailscale,
# set this to the GPU server's Tailscale IPv4 address.
TTS_BIND_ADDRESS=127.0.0.1
TTS_PORT=8100

TTS_DEVICE=cuda
TTS_REQUIRE_CUDA=true
TTS_VOICE_ID=saksham

# Optional custom voice. Use a clean 8-12 second WAV that you have permission to clone.
# Leave empty to use the model's bundled voice.
TTS_VOICE_PROMPT=

TTS_MAX_CHARS=600
TTS_TEMPERATURE=0.8
TTS_SEED=2026
TTS_TOP_P=0.95
TTS_TOP_K=1000
TTS_REPETITION_PENALTY=1.2
TTS_WARMUP_TEXT=Ready.

# Optional for gated/private Hugging Face downloads.
HF_TOKEN=
NVIDIA_VISIBLE_DEVICES=all
