# Generate with: openssl rand -hex 32
TTS_API_KEY=replace-with-a-long-random-token

TTS_DEVICE=mps
TTS_REQUIRE_CUDA=false
TTS_VOICE_ID=saksham

# Optional custom voice. Path is relative to services/chatterbox_tts.
TTS_VOICE_PROMPT=

TTS_MAX_CHARS=600
TTS_TEMPERATURE=0.8
TTS_SEED=2026
TTS_TOP_P=0.95
TTS_TOP_K=1000
TTS_REPETITION_PENALTY=1.2
TTS_WARMUP_TEXT=Ready.

# Allow individual unsupported Metal operations to fall back to CPU.
PYTORCH_ENABLE_MPS_FALLBACK=1
HF_HOME=.cache/huggingface
HF_TOKEN=
